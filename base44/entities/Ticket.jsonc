{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "student_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e1\u05d8\u05d5\u05d3\u05e0\u05d8"
    },
    "student_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05e1\u05d8\u05d5\u05d3\u05e0\u05d8"
    },
    "student_id": {
      "type": "string",
      "description": "\u05ea\u05e2\u05d5\u05d3\u05ea \u05d6\u05d4\u05d5\u05ea (\u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9)"
    },
    "category": {
      "type": "string",
      "enum": [
        "course_admin",
        "assignments",
        "quiz",
        "exam",
        "statistics_content",
        "excel",
        "technical",
        "other"
      ],
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4"
    },
    "subtopic": {
      "type": "string",
      "description": "\u05ea\u05ea-\u05e0\u05d5\u05e9\u05d0"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "description": "\u05d3\u05d7\u05d9\u05e4\u05d5\u05ea"
    },
    "subject": {
      "type": "string",
      "description": "\u05e0\u05d5\u05e9\u05d0 \u05d4\u05e4\u05e0\u05d9\u05d9\u05d4"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05de\u05e4\u05d5\u05e8\u05d8"
    },
    "attachment_url": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d1\u05e5 \u05de\u05e6\u05d5\u05e8\u05e3"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "in_progress",
        "waiting_for_student",
        "resolved"
      ],
      "default": "new",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "assigned_tas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05ea\u05e8\u05d2\u05dc\u05d9\u05dd \u05de\u05d5\u05e7\u05e6\u05d9\u05dd (\u05d0\u05d9\u05de\u05d9\u05d9\u05dc\u05d9\u05dd)"
    },
    "ticket_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e4\u05e0\u05d9\u05d9\u05d4"
    },
    "email_consent": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05e1\u05db\u05de\u05d4 \u05dc\u05d9\u05e6\u05d9\u05e8\u05ea \u05e7\u05e9\u05e8"
    }
  },
  "required": [
    "student_name",
    "student_email",
    "category",
    "subject",
    "description"
  ]
}